# Public, read-only values (safe in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix with NEXT_PUBLIC_.
# Viewer token, only needed for draft preview mode.
SANITY_API_READ_TOKEN=

# Paystack (server only). Test key first (sk_test_...), live key only at launch.
PAYSTACK_SECRET_KEY=
# Server only. Needs Editor permission. Stores paid registrations in Sanity. Optional but recommended.
SANITY_API_WRITE_TOKEN=
